import os


class TemplateEngine:


    name = "template_engine"


    def __init__(self):

        self.templates = {}


    def select(self, request):

        text = request.lower()

        if "ماشین حساب" in text or "calculator" in text:

            return {
                "main.py": """
def add(a,b):
    return a+b


def subtract(a,b):
    return a-b


def multiply(a,b):
    return a*b


def divide(a,b):
    return a/b


if __name__ == "__main__":
    print(add(5,3))
"""
            }


        return {
            "main.py": """
print('Generated by Sepehr')
"""
        }



    def get_or_create(self, template, features):

        path = f"core/templates/generated/{template}"


        if not os.path.exists(path):

            from core.templates.template_creator import template_creator

            return template_creator.create(
                template,
                features
            )


        return {
            "template": template,
            "status": "exists",
            "path": path
        }



    def load(self, template_result):


        files = {}


        paths = template_result.get(
            "files",
            []
        )


        for path in paths:

            if os.path.exists(path):

                with open(
                    path,
                    "r",
                    encoding="utf-8"
                ) as f:

                    name = os.path.basename(path)

                    name = name.replace(
                        ".template",
                        ""
                    )

                    files[name] = f.read()


        return files



template_engine = TemplateEngine()
