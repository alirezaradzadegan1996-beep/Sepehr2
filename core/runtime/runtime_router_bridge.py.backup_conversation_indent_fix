_runtime_bridge_instance = None


def autonomous_pipeline(text):
    global _runtime_bridge_instance

    if _runtime_bridge_instance is None:
        _runtime_bridge_instance = RuntimeRouterBridge()

    return _runtime_bridge_instance.execute(text)
