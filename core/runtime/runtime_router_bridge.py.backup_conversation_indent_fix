class RuntimeRouterBridge:


    def __init__(self):
        self.capability_memory = CapabilityMemory()
        self.matcher = CapabilityMatcher()
        self.resolver = CapabilityResolver()
        self.creator = CapabilityCreator()
        self.tester = CapabilityTester()
        self.quality = CapabilityQuality()

        self.capability_matcher = CapabilityMatcher()
        self.capability_resolver = CapabilityResolver()
        self.feedback = CapabilityFeedback()
        self.quality_engine = CapabilityQualityEngine()
        self.experience_selector = CapabilityExperienceSelector()
        self.experience_memory = ExperienceMemory()
        self.memory_intelligence = MemoryIntelligence()
        self.memory_manager = memory_manager
        self.capability_creator = CapabilityCreator()
        self.capability_tester = CapabilityTester()
        self.capability_quality = CapabilityQuality()

        self.routes = {
            "chat":"conversation",
            "memory":"memory",
            "build":"project_builder",
            "learn":"knowledge",
            "voice":"voice",
            "decision":"decision",
            "agent":"agent",
            "world":"world"
        }



    def detect_route(self, text):

        text = text.lower()

        if any(x in text for x in [
            "بساز",
            "ساخت",
            "اپ",
            "برنامه"
        ]):
            return "build"

        if any(x in text for x in [
            "من علیرضا هستم",
            "یاد بگیر",
            "به خاطر بسپار"
        ]):
            return "memory"

        return "chat"



    def execute(self, text):
        self._performance_recorded = set()

        try:
            memory_result = self.experience_memory.recall()

            experience_context = memory_result.get(
                "experiences",
                []
            )

            from core.memory.experience_normalizer import experience_normalizer

            normalized_experiences = [
                experience_normalizer.normalize(x)
                for x in experience_context
            ]

            experience_analysis = experience_analyzer.analyze(
                text,
                normalized_experiences
            )

            print(
                "Experience Analysis:",
                experience_analysis
            )

            memory_payload = {
                "current_task": text,
                "experiences": experience_context,
                "count": len(experience_context)
            }

            memory_analysis = self.memory_intelligence.analyze(
                memory_payload
            )

            print("Memory Intelligence:", memory_analysis)

            decision = decision_core.decide(
                text,
                memory_context=memory_analysis
            )
            print("Decision:", decision)
            print("Decision TYPE:", type(decision))


            # =====================================
            # SELF COMPLETION EXECUTION
            # =====================================

            if decision.get("route") == "self_completion":

                print("Self Completion Execution")

                result = self_completion_service.analyze()

                return {
                    "route":"self_completion",
                    "status":"executed",
                    "result":result
                }


            # =====================================
            # EXISTING CAPABILITY EXECUTION BRIDGE
            # =====================================

            if decision.get("route") == "capability":

                cap_name = decision.get("capability")

                try:

                    cap = registry.find(cap_name)

                    if cap:

                        print(
                            "Decision Capability Execution:",
                            cap_name
                        )

                        result = cap.handle(text)


                        # =====================================
                        # MEMORY MANAGER EXPERIENCE SAVE
                        # =====================================

                        try:

                            memory_result = self.memory_manager.remember_experience(
                                text,
                                cap_name,
                                "success",
                                "capability executed successfully"
                            )

                            print(
                                "MemoryManager saved:",
                                memory_result
                            )

                        except Exception as e:

                            print(
                                "MemoryManager bypass:",
                                e
                            )

                        try:
                            if cap_name not in self._performance_recorded:

                                capability_performance.record(
                                    cap_name,
                                    success=True
                                )

                                self._performance_recorded.add(
                                    cap_name
                                )

                                print(
                                    "Performance recorded:",
                                    cap_name
                                )

                                # =====================================
                                # FEEDBACK LOOP CONNECTION
                                # =====================================

                                try:

                                    feedback_result = (
                                        feedback_analyzer.analyze(
                                            self.experience_memory.recall()
                                        )
                                    )

                                    print(
                                        "Feedback Analysis:",
                                        feedback_result
                                    )

                                except Exception as e:

                                    print(
                                        "Feedback bypass:",
                                        e
                                    )

                                try:
                                    improvement = self_improvement.analyze(
                                        cap_name
                                    )

                                    print(
                                        "Self Improvement:",
                                        improvement
                                    )

                                    if improvement.get(
                                        "status"
                                    ) == "promoted":

                                        if evolution_policy.should_evolve(cap_name):

                                            evolution_result = evolution_executor.execute(
                                                improvement
                                            )

                                            print(
                                                "Evolution Result:",
                                                evolution_result
                                            )

                                        else:

                                            print(
                                                "Evolution skipped by policy"
                                            )
                                except Exception as e:
                                    print(
                                        "Self Improvement bypass:",
                                        e
                                    )
                        except Exception as e:
                            print(
                                "Performance bypass:",
                                e
                            )

                        try:
                            if cap_name not in self._performance_recorded:

                                capability_performance.record(
                                    cap_name,
                                    success=True
                                )

                                self._performance_recorded.add(
                                    cap_name
                                )

                                print(
                                    "Performance recorded:",
                                    cap_name
                                )

                                try:
                                    improvement = self_improvement.analyze(
                                        cap_name
                                    )

                                    print(
                                        "Self Improvement:",
                                        improvement
                                    )

                                except Exception as e:
                                    print(
                                        "Self Improvement bypass:",
                                        e
                                    )
                        except Exception as e:
                            print(
                                "Performance bypass:",
                                e
                            )

                        try:
                            if "evolution_result" in locals():
                                result["version"] = evolution_result.get(
                                    "result",
                                    {}
                                ).get(
                                    "version",
                                    result.get("version")
                                )
                        except Exception:
                            pass

                        return {
                            "route":"capability",
                            "capability":cap_name,
                            "result":result
                        }

                except Exception as e:

                    print(
                        "Capability execution bypass:",
                        e
                    )


            # =====================================
            # CAPABILITY EVOLUTION ROUTE
            # =====================================
            if decision.get("route") == "capability_evolution":

                print("Evolution route activated")

                try:
                    capability_name = text.replace(
                        "قابلیت",""
                    ).replace(
                        "اضافه کن",""
                    ).replace(
                        "بساز",""
                    ).strip()

                    if not capability_name:
                        capability_name = "new_ai"

                    capability_name = capability_name.replace(" ","_") + "_ai"

                    print(
                        "Creating capability:",
                        capability_name
                    )

                    created = self.capability_creator.create(
                        capability_name
                    )

                    tested = self.capability_tester.test(
                        capability_name
                    )


                    # =====================================
                    # REGISTER NEW CAPABILITY
                    # =====================================

                    try:

                        import importlib

                        module = importlib.import_module(
                            "core.capabilities." + capability_name
                        )

                        if hasattr(module,"capability"):

                            registry.register(
                                capability_name,
                                module.capability
                            )

                            print(
                                "Registry registered:",
                                capability_name
                            )

                    except Exception as e:

                        print(
                            "Registry bypass:",
                            e
                        )


                    return {
                        "route":"capability_evolution",
                        "capability":capability_name,
                        "created":created,
                        "tested":tested
                    }

                except Exception as e:
                    print(
                        "Evolution error:",
                        e
                    )


        except Exception as e:
            import traceback
            traceback.print_exc()
            print("Decision bypass:", e)


        # =====================================
        
        # =====================================
        # CAPABILITY PRIORITY FINAL LAYER
        # =====================================

        try:

            blocked_words = [
                "سلام",
                "خوبی",
                "من ",
                "هستم",
                "ماشین حساب",
                "اپ "
            ]

            blocked = any(
                x in text.lower()
                for x in blocked_words
            )

            if not blocked:

                cap_name = self.capability_resolver.resolve(text)

                if cap_name:

                    cap = registry.find(cap_name)

                    if cap:
                        print("Capability selected:", cap_name)

                        result = cap.handle(text)


                        # =====================================
                        # MEMORY MANAGER EXPERIENCE SAVE
                        # =====================================

                        try:

                            memory_result = self.memory_manager.remember_experience(
                                text,
                                cap_name,
                                "success",
                                "capability executed successfully"
                            )

                            print(
                                "MemoryManager saved:",
                                memory_result
                            )

                        except Exception as e:

                            print(
                                "MemoryManager bypass:",
                                e
                            )

                        try:
                            self.capability_memory.record(
                                cap_name,
                                success=True
                            )
                            print("Memory recorded:", cap_name)
                        except Exception as e:
                            print("Memory bypass:", e)


                        try:
                            self.feedback.record(
                                cap_name,
                                success=True
                            )

                            print(
                                "Feedback recorded:",
                                cap_name
                            )

                            try:
                                self.experience_memory.remember(
                                    text,
                                    cap_name,
                                    "success",
                                    "capability executed correctly"
                                )

                                self.experience_memory.save()

                                self.memory_intelligence.analyze({
                                    "current_task": text,
                                    "success": True
                                })

                                print("Experience recorded:", cap_name)

                            except Exception as e:
                                print("Experience bypass:", e)

                        except Exception as e:
                            print(
                                "Feedback bypass:",
                                e
                            )


                        # Run capability evolution after successful execution
                        try:
                            evolution_result = evolution_executor.execute(
                                cap_name,
                                "increase_priority"
                            )

                            print(
                                "Evolution Result:",
                                evolution_result
                            )

                            result["evolution"] = evolution_result

                        except Exception as e:
                            print(
                                "Evolution bypass:",
                                e
                            )

                        return {
                            "route":"capability",
                            "capability":cap_name,
                            "result":result
                        }

        except Exception as e:
            print("Capability guard bypass:", e)

# NORMAL ROUTING
        # =====================================

        route = self.detect_route(text)


        if route == "capability_evolution":

            return self._evolution_trigger(text)


        if route == "build":
            return project_manager.build_project(text)


        if route == "memory":

            return {
                "route":"memory",
                "action":"save_experience",
                "status":"sent_to_memory"
            }


            conversation_context = conversation.understand(text)

            conversation_answer = conversation.generate_response(
                conversation_context
            )

            conversation.remember(
                text,
                conversation_answer["response"]
            )

            return {
                "route": "conversation",
                "action": "generate_response",
                "status": "completed",
                "response": conversation_answer
            }




    def _experience_memory_score(self, capability):

        try:
            self.experience_memory.load()

            experiences = self.experience_memory.recall()

            score = 0

            for exp in experiences:

                skill = exp.get("skill","")

                if skill == capability:

                    result = exp.get("result")

                    if result == "success":
                        score += 0.2

                    elif isinstance(result, dict):
                        if result.get("success"):
                            score += 0.2

            return min(score,1)

        except Exception:
            return 0

    def _feedback_score(self, capability):
        try:
            data = self.feedback.get(capability)

            if not data:
                return 0

            success = data.get("success", 0)
            failed = data.get("failed", 0)

            total = success + failed

            if total == 0:
                return 0

            return min(success / total, 1)

        except Exception:
            return 0



    def _evolution_trigger(self, text):

        try:

            name = (
                text.lower()
                .replace(" ", "_")
                .replace("بساز", "")
                .replace("ایجاد_کن", "")
                .strip("_")
            )

            name = name + "_ai"

            print("Evolution creating:", name)

            created = self.capability_creator.create(name)

            if created.get("status") != "created":

                return {
                    "route":"evolution",
                    "status":"creation_failed"
                }


            test = self.capability_tester.test(name)


            if test.get("valid"):

                try:
                    registry.load()
                    print("Registry reloaded:", name)
                except Exception as e:
                    print("Registry reload bypass:", e)


                return {
                    "route":"evolution",
                    "capability":name,
                    "status":"created"
                }


            return {
                "route":"evolution",
                "capability":name,
                "status":"test_failed"
            }


        except Exception as e:

            print("Evolution error:", e)

            return {
                "route":"evolution",
                "status":"failed"
            }


    def _select_best_capability(self, candidates):

        try:

            ranked = []

            for c in candidates:

                try:

                    experience_score = self.experience_selector.score(c)

                    memory_score = self._experience_memory_score(c)

                    quality_score = self.quality_engine.score(c)

                    feedback = self.feedback.get(c)

                    feedback_score = 0

                    if feedback:
                        success = feedback.get("success", 0)
                        failed = feedback.get("failed", 0)

                        total = success + failed

                        if total:
                            feedback_score = success / total


                    score = (
                        experience_score * 0.3
                        +
                        memory_score * 0.4
                        +
                        quality_score * 0.2
                        +
                        feedback_score * 0.1
                    )

                    ranked.append({
                        "capability": c,
                        "score": score
                    })

                except:
                    pass


            if ranked:

                ranked.sort(
                    key=lambda x:x["score"],
                    reverse=True
                )

                print("Adaptive ranking:", ranked)

                return ranked[0]["capability"]


        except Exception as e:

            print("Adaptive selector bypass:", e)


        return None



    def _filter_capabilities(self, candidates):

        blocked = [
            "سلام_ai",
            "من_ai",
            "یک_ai"
        ]

        return [
            c for c in candidates
            if c not in blocked
        ]

    def status(self):

        return {
            "routes": self.routes,
            "status": "runtime_router_active"
        }

